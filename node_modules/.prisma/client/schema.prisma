generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TicketStatus {
  approved
  rejected
  pending
}

model complaines {
  UniqueID  String   @id @default(cuid())
  msgs      Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  ticket_id String?  @unique @map("ticket_id")
  ticket    tickets? @relation(fields: [ticket_id], references: [UniqueID])

  @@map("complaines")
}

model tickets {
  UniqueID          String       @id @default(cuid())
  category          String       @db.VarChar(255)
  priority          Int
  department        String       @db.VarChar(255)
  draft_report      String       @db.Text
  status            TicketStatus @default(pending)
  extracted_entites Json         @db.JsonB
  confidence_score  String
  complaine         complaines?

  @@map("tickets")
}
